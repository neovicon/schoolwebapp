{
  "kind": "collectionType",
  "collectionName": "teacher_profiles",
  "info": {
    "singularName": "teacher-profile",
    "pluralName": "teacher-profiles",
    "displayName": "Teacher Profile",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "employeeId": {
      "type": "string",
      "required": true
    },
    "phoneNumber": {
      "type": "string",
      "required": true
    },
    "qualification": {
      "type": "string"
    },
    "joiningDate": {
      "type": "date"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "on_leave",
        "retired",
        "resigned",
        "archived"
      ],
      "default": "active"
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "dateOfBirth": {
      "type": "date"
    },
    "gender": {
      "type": "enumeration",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "bloodGroup": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "email": {
      "type": "email"
    },
    "school": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::school.school",
      "inversedBy": "teacherProfiles"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "teacher": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::teacher.teacher"
    },
    "sections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::section.section",
      "mappedBy": "teacherProfile"
    },
    "subjects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::subject.subject",
      "mappedBy": "teacherProfiles"
    },
    "teachingAssignments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::teaching-assignment.teaching-assignment",
      "mappedBy": "teacherProfile"
    }
  }
}
